JUMP op_end$2
LABEL op_concat$0
CONCAT GF@tmp_res GF@tmp_op1 GF@tmp_op2
PUSHS GF@tmp_res
LABEL op_end$2
POPS LF@s3$2
PUSHS LF@s3$2
POPS GF@tmp_op1
WRITE GF@tmp_op1
PUSHS nil@nil
POPS GF@__d
POPFRAME
RETURN
