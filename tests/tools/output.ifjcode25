.IFJcode25
DEFVAR GF@tmp_op1
DEFVAR GF@tmp_op2
DEFVAR GF@tmp_res
DEFVAR GF@tmp_type
DEFVAR GF@__d
MOVE GF@__d nil@nil
CREATEFRAME
CALL $$main
EXIT int@0
LABEL $$main
CREATEFRAME
PUSHFRAME
DEFVAR LF@retval
MOVE LF@retval nil@nil
DEFVAR LF@s1$0
MOVE LF@s1$0 nil@nil
PUSHS string@Hello
POPS LF@s1$0
DEFVAR LF@s2$1
MOVE LF@s2$1 nil@nil
PUSHS string@\032World
POPS LF@s2$1
DEFVAR LF@s3$2
MOVE LF@s3$2 nil@nil
PUSHS LF@s1$0
PUSHS LF@s2$1
POPS GF@tmp_op2
POPS GF@tmp_op1
PUSHS GF@tmp_op1
TYPES
